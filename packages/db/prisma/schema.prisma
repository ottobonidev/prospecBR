generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conta {
  id          String            @id @default(cuid())
  nomeEmpresa String
  cnpj        String            @unique
  plano       String            @default("trial")
  criadoEm    DateTime          @default(now())
  usuarios    Usuario[]
  convites    ConviteVendedor[]

  creditPlan          CreditPlan?
  creditAllocations   CreditAllocation[]
  creditLedgerEntries CreditLedgerEntry[]
  faturas             FaturaMensal[]
}

enum Papel {
  LOJISTA
  VENDEDOR
}

enum StatusUsuario {
  ATIVO
  INATIVO
}

model Usuario {
  id        String        @id @default(cuid())
  contaId   String
  conta     Conta         @relation(fields: [contaId], references: [id])
  nome      String
  email     String        @unique
  senhaHash String
  papel     Papel
  status    StatusUsuario @default(ATIVO)
  criadoEm  DateTime      @default(now())

  creditAllocations   CreditAllocation[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([contaId])
}

model ConviteVendedor {
  id       String    @id @default(cuid())
  contaId  String
  conta    Conta     @relation(fields: [contaId], references: [id])
  email    String
  token    String    @unique
  aceitoEm DateTime?
  expiraEm DateTime
  criadoEm DateTime  @default(now())

  @@index([contaId])
}

enum StatusObra {
  ATIVA
  ENCERRADA
  NULA
  SUSPENSA
  PARALISADA
}

model Obra {
  id              String     @id @default(cuid())
  cno             String     @unique
  cnpjResponsavel String
  razaoSocial     String
  uf              String
  cidade          String
  bairro          String?
  cep             String?
  status          StatusObra
  dataInicio      DateTime?
  natureza        String?
  areaConstruida  Float?
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt

  @@index([uf, cidade, status])
}

model CreditPlan {
  id                      String   @id @default(cuid())
  contaId                 String   @unique
  conta                   Conta    @relation(fields: [contaId], references: [id])
  cotaMensalGratis        Int
  precoCustoLeadsCentavos Int
  precoVendaLeadsCentavos Int
  criadoEm                DateTime @default(now())
}

model CreditAllocation {
  id           String   @id @default(cuid())
  contaId      String
  conta        Conta    @relation(fields: [contaId], references: [id])
  usuarioId    String
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])
  cotaAlocada  Int
  atualizadoEm DateTime @updatedAt

  @@unique([contaId, usuarioId])
}

enum TipoConsumoCredito {
  LEADS_SEARCH
}

model CreditLedgerEntry {
  id            String             @id @default(cuid())
  contaId       String
  conta         Conta              @relation(fields: [contaId], references: [id])
  usuarioId     String
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  tipo          TipoConsumoCredito
  excedente     Boolean
  mesReferencia String
  criadoEm      DateTime           @default(now())

  @@index([contaId, mesReferencia])
}

enum StatusFatura {
  PENDENTE
  PAGA
}

model FaturaMensal {
  id                  String       @id @default(cuid())
  contaId             String
  conta               Conta        @relation(fields: [contaId], references: [id])
  mesReferencia       String
  quantidadeExcedente Int
  valorTotalCentavos  Int
  status              StatusFatura @default(PENDENTE)
  criadoEm            DateTime     @default(now())

  @@unique([contaId, mesReferencia])
}

model ObrasSyncCursor {
  id                  String   @id @default("obras_sync_cursor")
  ultimaSincronizacao DateTime
  atualizadoEm        DateTime @updatedAt
}
